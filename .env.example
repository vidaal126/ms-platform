# Copie para .env para sobrescrever os padroes do docker-compose.yml.

# Postgres (um container, dois databases)
POSTGRES_PORT=5433
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=catalog
CATALOG_DB_NAME=catalog
TRANSPORT_DB_USER=transport
TRANSPORT_DB_PASSWORD=transport
TRANSPORT_DB_NAME=transport

# Kafka
KAFKA_EXTERNAL_PORT=9092
KAFKA_UI_PORT=8090

# Apps
CATALOG_PORT=3000
TRANSPORT_PORT=3001
LOG_LEVEL=info
CATALOG_SYNC_GROUP_ID=ms-transport.catalog-item-sync

# Volumes (ambiente isolado: ex. ms-validation_postgres_data / ms-validation_kafka_data)
POSTGRES_VOLUME=ms-platform_postgres_data
KAFKA_VOLUME=ms-catalog_kafka_data

# Contextos de build (repositorios irmaos)
CATALOG_CONTEXT=../ms-catalog
TRANSPORT_CONTEXT=../ms-transport
