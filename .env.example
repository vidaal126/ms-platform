# Copie para .env para sobrescrever os padroes do docker-compose.yml.

# Postgres (um container, um database e um usuario por servico)
POSTGRES_PORT=5433
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=catalog
CATALOG_DB_NAME=catalog
TRANSPORT_DB_USER=transport
TRANSPORT_DB_PASSWORD=transport
TRANSPORT_DB_NAME=transport
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth
AUTH_DB_NAME=auth
CUSTOMER_DB_USER=customer
CUSTOMER_DB_PASSWORD=customer
CUSTOMER_DB_NAME=customer
SALES_ORDER_DB_USER=sales_order
SALES_ORDER_DB_PASSWORD=sales_order
SALES_ORDER_DB_NAME=sales_order

# Kafka
KAFKA_EXTERNAL_PORT=9092
KAFKA_UI_PORT=8090

# Admin inicial do ms-auth (TROQUE fora do ambiente local)
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@ms-platform.local
AUTH_BOOTSTRAP_ADMIN_PASSWORD=admin-dev-password

# Portas no host (gateway e a entrada publica; as demais sao para dev)
GATEWAY_PORT=8088
AUTH_PORT=3002
CATALOG_PORT=3000
TRANSPORT_PORT=3001
CUSTOMER_PORT=3003
SALES_ORDER_PORT=3004
LOG_LEVEL=info

# Observabilidade
GRAFANA_PORT=3300
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=7d
LOKI_PORT=3100

# Volumes (ambiente isolado: troque o prefixo, ex. ms-validation_*)
POSTGRES_VOLUME=ms-platform_postgres_data
KAFKA_VOLUME=ms-catalog_kafka_data
AUTH_KEYS_VOLUME=ms-platform_auth_keys
PROMETHEUS_VOLUME=ms-platform_prometheus_data
LOKI_VOLUME=ms-platform_loki_data
GRAFANA_VOLUME=ms-platform_grafana_data

# Contextos de build (repositorios irmaos)
GATEWAY_CONTEXT=../ms-gateway
AUTH_CONTEXT=../ms-auth
CATALOG_CONTEXT=../ms-catalog
TRANSPORT_CONTEXT=../ms-transport
CUSTOMER_CONTEXT=../ms-customer
SALES_ORDER_CONTEXT=../ms-sales-order
